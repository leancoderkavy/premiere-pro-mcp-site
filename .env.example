# Server-side homepage experiment (proxy.ts, app/api/landing-events).
# The experiment runs only when all three of the first values are set.
HOMEPAGE_EXPERIMENT_ENABLED=false
# 32+ random characters, e.g. `openssl rand -base64 48`. Signs the assignment cookie.
HOMEPAGE_EXPERIMENT_SECRET=
# PostHog project API key (phc_...) for server-side flag evaluation and events.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional browser analytics overrides (build time).
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
